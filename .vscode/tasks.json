{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch and publish solution saves",
      "type": "process",
      "command": "/opt/homebrew/bin/python3",
      "args": [
        "${workspaceFolder}/push_solution.py",
        "--watch"
      ],
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
